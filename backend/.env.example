# Copy to .env for local overrides, or set these as real environment
# variables in your hosting platform (Railway/Render/etc).

# Postgres in production, e.g:
# postgresql://user:password@host:5432/dbname
# Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./itsm.db

# Generate a real secret for production, e.g: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000
